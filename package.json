{
  "name": "dsh-all-in-one",
  "version": "0.3.8",
  "description": "All-in-one DeepSeek Harness bundle: one install mounts the whole leonardoxr DSH plugin collection (coding tools, plugin/config managers, sidebar, usage meters, updaters and more).",
  "license": "MIT",
  "author": {
    "name": "leonardoxr",
    "email": "leonardoxr@users.noreply.github.com"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardoxr/dsh-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/leonardoxr/dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "bundle",
    "aggregate"
  ],
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/aggregate.mjs",
    "verify": "node scripts/aggregate.mjs --verify",
    "test": "pnpm run verify",
    "prepack": "pnpm run verify"
  },
  "devDependencies": {
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@leonardoxr/dsh-plugin-manager": "https://github.com/leonardoxr/dsh-plugin-manager/releases/download/v0.2.0/leonardoxr-dsh-plugin-manager-0.2.0.tgz",
    "dsh-auto-chat-titles": "https://github.com/leonardoxr/dsh-auto-chat-titles/releases/download/v0.1.0/dsh-auto-chat-titles-0.1.0.tgz",
    "dsh-claude-usage": "https://github.com/leonardoxr/dsh-claude-usage/releases/download/v0.1.4/dsh-claude-usage-0.1.4.tgz",
    "dsh-codex-usage": "https://github.com/leonardoxr/dsh-codex-usage/releases/download/v0.1.8/dsh-codex-usage-0.1.8.tgz",
    "dsh-coding-tools": "https://github.com/leonardoxr/dsh-coding-tools/releases/download/v0.1.6/dsh-coding-tools-0.1.6.tgz",
    "dsh-companion": "https://github.com/leonardoxr/dsh-companion/releases/download/v0.2.2/dsh-companion-0.2.2.tgz",
    "dsh-harness-updater": "https://github.com/leonardoxr/dsh-harness-updater/releases/download/v0.1.0/dsh-harness-updater-0.1.0.tgz",
    "dsh-image-preview": "https://github.com/leonardoxr/dsh-image-preview/releases/download/v0.3.1/dsh-image-preview-0.3.1.tgz",
    "dsh-routed-subagent": "https://github.com/leonardoxr/dsh-routed-subagent/releases/download/v0.3.1/dsh-routed-subagent-0.3.1.tgz",
    "dsh-status-bar-config": "https://github.com/leonardoxr/dsh-status-bar-config/releases/download/v0.2.1/dsh-status-bar-config-0.2.1.tgz",
    "dsh-workspace-git": "https://github.com/leonardoxr/dsh-workspace-git/releases/download/v0.1.1/dsh-workspace-git-0.1.1.tgz"
  }
}
